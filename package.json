{
  "name": "solari-backend",
  "main": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && cp -R src/routes/assets dist/routes/assets",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "worker": "node dist/jobs/worker.js",
    "worker:dev": "tsx watch src/jobs/worker.ts",
    "db:migrate": "drizzle-kit migrate",
    "fmt": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^7.0.11",
    "drizzle-kit": "^0.31.9",
    "prettier": "^3.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1007.0",
    "@aws-sdk/s3-request-presigner": "^3.1007.0",
    "@elysia/node": "^1.4.6",
    "argon2": "^0.44.0",
    "bullmq": "^5.73.2",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.27",
    "google-auth-library": "^10.6.1",
    "image-size": "^2.0.2",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.2",
    "postgres": "^3.4.8"
  }
}
